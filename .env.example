# Скопируйте в .env и заполните нужное. Без LLM всё работает на правилах.

# Часовой пояс пользователя (все даты считаются в нём)
TIMEZONE=Europe/Moscow

# База данных: по умолчанию SQLite-файл data/assistant.db. Для Postgres:
# DATABASE_URL=postgresql+psycopg://user:pass@host:5432/assistant
# CSV с исходными событиями: загружается один раз, если база пуста. Пусто — без демо-данных.
# SEED_CSV=data/events_seed.csv

# ---------- LLM ----------
# openai — любой OpenAI-совместимый API ниже; gigachat — напрямую через официальный SDK.
LLM_PROVIDER=openai

# GigaChat: укажите LLM_PROVIDER=gigachat и вставьте Authorization key из проекта GigaChat API.
# Это постоянный ключ авторизации, НЕ временный access_token и НЕ пароль Сбер ID.
# SDK получает и обновляет access_token автоматически. Прокси не нужен.
GIGACHAT_CREDENTIALS=
GIGACHAT_SCOPE=GIGACHAT_API_PERS
GIGACHAT_MODEL=GigaChat-2-Max
# При ошибке проверки TLS: путь к PEM-файлу официального корневого сертификата НУЦ Минцифры.
# Проверка TLS всегда включена. Системные доверенные сертификаты тоже используются.
GIGACHAT_CA_BUNDLE_FILE=

# ---------- OpenAI-совместимые API (LLM_PROVIDER=openai) ----------

# Groq:
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_API_KEY=gsk_...
# LLM_MODEL=llama-3.3-70b-versatile

# OpenRouter (модели с суффиксом :free):
# LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_API_KEY=sk-or-...
# LLM_MODEL=<модель>:free

# Ollama локально (полностью бесплатно, без интернета):
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=qwen2.5:7b

LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_TIMEOUT=20

# ---------- Серверное распознавание речи (необязательно) ----------
# По умолчанию речь распознаёт браузер. Серверный вариант нужен для Firefox и для качества, например Groq Whisper:
# STT_BASE_URL=https://api.groq.com/openai/v1
# STT_API_KEY=gsk_...
# STT_MODEL=whisper-large-v3-turbo
STT_BASE_URL=
STT_API_KEY=
STT_MODEL=

# ---------- Эмбеддинги для семантического поиска (необязательно) ----------
# Например, Ollama: ollama pull bge-m3
# EMBEDDINGS_BASE_URL=http://localhost:11434/v1
# EMBEDDINGS_MODEL=bge-m3
EMBEDDINGS_BASE_URL=
EMBEDDINGS_API_KEY=
EMBEDDINGS_MODEL=
